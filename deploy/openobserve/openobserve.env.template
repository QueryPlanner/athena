# OpenObserve settings. scripts/setup-host.sh renders this into
# /etc/openobserve/openobserve.env (root, 0600) the first time only, filling
# the @...@ placeholders. It never overwrites an existing file.
#
# Variable names verified against src/config/src/config.rs at v1.0.4.

# Root account, created on first start only. The password is generated by
# setup-host.sh and printed once; change it in the UI afterwards if you like.
ZO_ROOT_USER_EMAIL=@ROOT_EMAIL@
ZO_ROOT_USER_PASSWORD=@ROOT_PASSWORD@

# Listen on the tailnet IP only; never 0.0.0.0. It takes one address, so
# the UI and Athena's OTLP/HTTP ingest (/api/default/v1/{traces,logs}) share
# it; Athena reaches it on the same host.
ZO_HTTP_ADDR=@TAILNET_IP@
ZO_HTTP_PORT=5080
# gRPC ingest is unused (Athena sends OTLP/HTTP); keep it private.
ZO_GRPC_ADDR=127.0.0.1
ZO_GRPC_PORT=5081
ZO_WEB_URL=http://@TAILNET_IP@:5080

ZO_LOCAL_MODE=true
ZO_DATA_DIR=/var/lib/openobserve/

# Its defaults size caches at 50% of system RAM, far above the unit's
# MemoryMax=512M on a shared VM. All sizes are MB.
ZO_MEM_TABLE_MAX_SIZE=96
ZO_MEMORY_CACHE_MAX_SIZE=96
ZO_MEMORY_CACHE_DATAFUSION_MAX_SIZE=96
ZO_DISK_CACHE_MAX_SIZE=1024

# Match the JSONL files' 30 days.
ZO_COMPACT_DATA_RETENTION_DAYS=30

# No phoning home.
ZO_TELEMETRY=false
