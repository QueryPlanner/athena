# Athena settings for the @ENV@ environment.
# /etc/athena/@ENV@.env (root:athena, 0640). Created once by
# scripts/setup-host.sh and never overwritten; edit it with
#   sudoedit /etc/athena/@ENV@.env
# Secrets are typed here by a human, never pasted into a chat or committed.
# deploy-gate rewrites the ATHENA_VERSION line on every deploy.

ATHENA_ENV=@ENV@
ATHENA_DB=/var/lib/athena/@ENV@/agent.db
# The tailnet IP only: never reachable from the public internet.
ATHENA_ADDR=@TAILNET_IP@:@PORT@
ATHENA_ALLOWED_HOSTS=@ALLOWED_HOSTS@

# Required. Staging should use its own spend-capped key.
OPENROUTER_API_KEY=
# AGENT_MODEL=openai/gpt-6-luna

# Keep the raw provider responses out of the runs table.
RUNS_STORE_RAW=0

# Telemetry. Athena writes its spans and logs as JSON lines here, one file
# per signal per day, for DuckDB (scripts/analytics.sh), and deletes files
# older than the retention. Remove the line to stop writing files.
ATHENA_TELEMETRY_DIR=/var/lib/athena/@ENV@/telemetry
ATHENA_TELEMETRY_RETENTION_DAYS=30
# It also exports them over OTLP/HTTP when the endpoint is set; remove the
# two OTEL_EXPORTER_OTLP_* lines to stop.
@OTLP_BLOCK@
OTEL_SERVICE_NAME=athena
# Every span carries its full content (prompts, the system prompt, replies,
# tool arguments and results); both sinks export all of it. There is no
# switch: to keep content out of telemetry, remove the two sinks above.

# Sandbox tools are registered only when OPEN_SANDBOX_URL is set.
# OPEN_SANDBOX_URL=http://<sandbox-tailnet-ip>:9090
# OPEN_SANDBOX_API_KEY=
# ATHENA_SANDBOX_IMAGE=ghcr.io/queryplanner/athena-sandbox:latest
# Web search through Exa; the web_search tool is registered only when this
# is set. A secret: type it here with sudoedit.
# EXA_API_KEY=
# Google Health, read-only; set all three or none. Secrets: type them here
# with sudoedit (the values Blacki uses). Then each user sends /connect_health
# once.
# GOOGLE_HEALTH_CLIENT_ID=
# GOOGLE_HEALTH_CLIENT_SECRET=
# GOOGLE_HEALTH_TOKEN_ENCRYPTION_KEY=
# GOOGLE_HEALTH_REDIRECT_URI=
# Sign-in links point at http://$ATHENA_ADDR unless this is set.
# ATHENA_PUBLIC_URL=http://<vm-tailnet-name>:@PORT@
@TELEGRAM_BLOCK@
# The Telegram bot transcribes voice notes with Cloudflare Workers AI when
# both are set; set both or neither.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
