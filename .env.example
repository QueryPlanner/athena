# Copy to .env and fill in. .env is git-ignored; never commit it.
# Variables already set in your shell take precedence over this file.

# Required for anything that talks to the model.
OPENROUTER_API_KEY=

# For `athena telegram`, from @BotFather.
TELEGRAM_BOT_TOKEN=

# Voice notes for `athena telegram`, transcribed by Cloudflare Workers AI.
# Set both or neither; unset means voice notes are not prompts.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Optional.
# AGENT_MODEL=openai/gpt-6-luna
# ATHENA_DB=agent.db      # serve and telegram need an absolute path
# ATHENA_ADDR=127.0.0.1:8080
# ATHENA_ALLOWED_HOSTS=    # e.g. 100.64.0.1:18080,athena-vm:18080
# RUNS_STORE_RAW=0
# ATHENA_COMPACT_AT=0.8          # compact a session above this share of the model's window
# ATHENA_COMPACT_MODEL=          # model that writes summaries; default AGENT_MODEL
# ATHENA_CONTEXT_TOKENS=         # the window, 8000 or more; default: OpenRouter's number for AGENT_MODEL, else 128000

# Your own instructions and skills, no Rust needed. Read once at startup.
# ATHENA_INSTRUCTIONS=/home/me/athena/instructions.md   # appended to the system prompt
# ATHENA_SKILLS_DIR=/home/me/athena/skills              # <name>/SKILL.md, Agent Skills format

# Sandbox and browser tools; unset means the agent has none.
# OPEN_SANDBOX_URL=http://100.118.54.67:9090
# OPEN_SANDBOX_API_KEY=
# ATHENA_SANDBOX_IMAGE=ghcr.io/queryplanner/athena-sandbox:latest
# ATHENA_SANDBOX_TIMEOUT_SECS=1800

# Tools from MCP servers: a JSON file in the `mcpServers` shape of Claude Code
# and Claude Desktop. Unset means none. Put tokens here, in this file or the
# VM's env file, and refer to them as "${NAME}" in the JSON; a stdio server
# runs on this machine, outside the sandbox, so list only servers you trust.
# ATHENA_MCP_CONFIG=/absolute/path/to/mcp.json
