# Copy to .env and fill in. .env is git-ignored; never commit it.
# Variables already set in your shell take precedence over this file.

# Required for anything that talks to the model.
OPENROUTER_API_KEY=

# For `athena telegram`, from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional.
# AGENT_MODEL=openai/gpt-5.6-luna
# ATHENA_DB=agent.db
# RUNS_STORE_RAW=0

# Sandbox and browser tools; unset means the agent has none.
# OPEN_SANDBOX_URL=http://100.118.54.67:9090
# OPEN_SANDBOX_API_KEY=
# ATHENA_SANDBOX_IMAGE=ghcr.io/queryplanner/athena-sandbox:latest
# ATHENA_SANDBOX_TIMEOUT_SECS=1800
