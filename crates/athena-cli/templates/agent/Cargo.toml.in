[package]
name = "@NAME@"
version = "0.1.0"
edition = "2024"
publish = false

# The release artifact holds a binary named `athena`: the runtime, running
# this agent. deploy-gate runs it by that name.
[[bin]]
name = "athena"
path = "src/main.rs"

[dependencies]
anyhow = "1.0.104"
athena-core = { @CORE_DEP@ }
# `#[rig_tool]` needs both as direct dependencies.
rig-agent = { version = "0.42.0", features = ["derive"] }
rig-core = "0.42.0"

[dev-dependencies]
athena-core = { @CORE_DEP@, features = ["testing"] }
rig-core = { version = "0.42.0", features = ["test-utils"] }
tokio = { version = "1.53.1", features = ["full"] }
